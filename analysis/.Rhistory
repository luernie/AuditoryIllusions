# ========================================
# REPEATED MEASURES ANOVA
# Auditory Illusions Experiment
# Risset & Shepard Stimuli
# ========================================
# Install packages if needed (comment out after first run)
# install.packages("tidyverse")
# install.packages("rstatix")
# install.packages("ggpubr")
# install.packages("ez")
library(tidyverse)
library(rstatix)
library(ggpubr)
library(ez)
# ========================================
# SET PATHS HERE
# ========================================
root_path   <- "C:/Users/luern/Documents/CodingProjects/AuditoryIllusions/output/"   # folder containing the 4 txt files
results_dir <- paste0(root_path, "anova_results/")
# ========================================
# 1. LOAD DATA
# ========================================
risset_blocks   <- read.table(paste0(root_path, "risset_blocks.txt"),           header=TRUE, sep="\t")
shepard_blocks  <- read.table(paste0(root_path, "shepard_blocks.txt"),          header=TRUE, sep="\t")
risset_ranking  <- read.table(paste0(root_path, "risset_ranking_summary.txt"),  header=TRUE, sep="\t")
shepard_ranking <- read.table(paste0(root_path, "shepard_ranking_summary.txt"), header=TRUE, sep="\t")
# ========================================
# 2. PREPARE FACTORS
# ========================================
# NOTE on blocks data:
# Modality was NOT randomised — each participant completed all three modalities
# in a fixed order (Block 1 = both, Block 2 = haptic, Block 3 = audio).
# Treating Modality as a within-subjects factor would confound modality with
# order/time effects. Instead, we collapse across modality and run a one-way
# repeated measures ANOVA on Stimulus only, then run separate one-way ANOVAs
# per modality as exploratory follow-ups.
#
# NOTE on ranking summary data:
# Both Modality and Stimulus were fully randomised, so a two-way repeated
# measures ANOVA (Modality x Stimulus) is appropriate here.
prepare_blocks <- function(df) {
df %>%
mutate(
ParticipantID = factor(ParticipantID),
Modality      = factor(Modality, levels = c("both", "haptic", "audio")),
Filename      = factor(Filename)
)
}
prepare_ranking <- function(df) {
df %>%
mutate(
ParticipantID = factor(ParticipantID),
Modality      = factor(Modality, levels = c("both", "haptic", "audio")),
Filename      = factor(Filename)
)
}
risset_blocks   <- prepare_blocks(risset_blocks)
shepard_blocks  <- prepare_blocks(shepard_blocks)
risset_ranking  <- prepare_ranking(risset_ranking)
shepard_ranking <- prepare_ranking(shepard_ranking)
# Collapse blocks data across modality: average Score per Participant x Stimulus
risset_blocks_collapsed  <- risset_blocks %>%
group_by(ParticipantID, Filename) %>%
summarise(Score_N = mean(Score_N, na.rm=TRUE), .groups="drop") %>%
mutate(ParticipantID = factor(ParticipantID),
Filename      = factor(Filename))
# ========================================
# REPEATED MEASURES ANOVA
# Auditory Illusions Experiment
# Risset & Shepard Stimuli
# ========================================
# Install packages if needed (comment out after first run)
# install.packages("tidyverse")
# install.packages("rstatix")
# install.packages("ggpubr")
# install.packages("ez")
library(tidyverse)
library(rstatix)
library(ggpubr)
library(ez)
# ========================================
# SET PATHS HERE
# ========================================
root_path   <- "C:/Users/luern/Documents/CodingProjects/AuditoryIllusions/output/"   # folder containing the 4 txt files
results_dir <- paste0(root_path, "anova_results/")
# ========================================
# 1. LOAD DATA
# ========================================
risset_blocks   <- read.table(paste0(root_path, "risset_blocks.txt"),           header=TRUE, sep="\t")
shepard_blocks  <- read.table(paste0(root_path, "shepard_blocks.txt"),          header=TRUE, sep="\t")
risset_ranking  <- read.table(paste0(root_path, "risset_ranking_summary.txt"),  header=TRUE, sep="\t")
shepard_ranking <- read.table(paste0(root_path, "shepard_ranking_summary.txt"), header=TRUE, sep="\t")
# ========================================
# 2. PREPARE FACTORS
# ========================================
# NOTE on blocks data:
# Modality was NOT randomised — each participant completed all three modalities
# in a fixed order (Block 1 = both, Block 2 = haptic, Block 3 = audio).
# Treating Modality as a within-subjects factor would confound modality with
# order/time effects. Instead, we collapse across modality and run a one-way
# repeated measures ANOVA on Stimulus only, then run separate one-way ANOVAs
# per modality as exploratory follow-ups.
#
# NOTE on ranking summary data:
# Both Modality and Stimulus were fully randomised, so a two-way repeated
# measures ANOVA (Modality x Stimulus) is appropriate here.
prepare_blocks <- function(df) {
df %>%
mutate(
ParticipantID = factor(ParticipantID),
Modality      = factor(Modality, levels = c("both", "haptic", "audio")),
Filename      = factor(Filename)
)
}
prepare_ranking <- function(df) {
df %>%
mutate(
ParticipantID = factor(ParticipantID),
Modality      = factor(Modality, levels = c("both", "haptic", "audio")),
Filename      = factor(Filename)
)
}
risset_blocks   <- prepare_blocks(risset_blocks)
shepard_blocks  <- prepare_blocks(shepard_blocks)
risset_ranking  <- prepare_ranking(risset_ranking)
shepard_ranking <- prepare_ranking(shepard_ranking)
# Collapse blocks data across modality: average Score per Participant x Stimulus
risset_blocks_collapsed  <- risset_blocks %>%
group_by(ParticipantID, Filename) %>%
summarise(Score_N = mean(Score_N, na.rm=TRUE), .groups="drop") %>%
mutate(ParticipantID = factor(ParticipantID),
Filename      = factor(Filename))
shepard_blocks_collapsed <- shepard_blocks %>%
group_by(ParticipantID, Filename) %>%
summarise(Score_N = mean(Score_N, na.rm=TRUE), .groups="drop") %>%
mutate(ParticipantID = factor(ParticipantID),
Filename      = factor(Filename))
# ========================================
# 3. DATA OVERVIEW
# ========================================
cat("=== DATA STRUCTURE ===\n\n")
cat("[ risset_blocks — collapsed across modality ]\n")
cat(sprintf("  Participants: %d\n", n_distinct(risset_blocks_collapsed$ParticipantID)))
cat(sprintf("  Stimuli:      %d unique filenames\n\n", n_distinct(risset_blocks_collapsed$Filename)))
cat("[ shepard_blocks — collapsed across modality ]\n")
cat(sprintf("  Participants: %d\n", n_distinct(shepard_blocks_collapsed$ParticipantID)))
cat(sprintf("  Stimuli:      %d unique filenames\n\n", n_distinct(shepard_blocks_collapsed$Filename)))
for (nm in c("risset_ranking", "shepard_ranking")) {
df <- get(nm)
cat(sprintf("[ %s ]\n", nm))
cat(sprintf("  Participants: %d\n", n_distinct(df$ParticipantID)))
cat(sprintf("  Modalities:   %s\n", paste(levels(df$Modality), collapse=", ")))
cat(sprintf("  Stimuli:      %d unique filenames\n\n", n_distinct(df$Filename)))
}
# ========================================
# 4. SUMMARY STATISTICS
# ========================================
# --- Blocks (collapsed) ---
summarise_blocks_collapsed <- function(df, label) {
cat(sprintf("\n=== SUMMARY STATISTICS: %s (collapsed across modality) ===\n", label))
cat("\nOverall:\n")
print(df %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Stimulus:\n")
print(df %>% group_by(Filename) %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Participant:\n")
print(df %>% group_by(ParticipantID) %>% get_summary_stats(Score_N, type="mean_sd"))
}
summarise_blocks_collapsed(risset_blocks_collapsed,  "Risset Blocks")
summarise_blocks_collapsed(shepard_blocks_collapsed, "Shepard Blocks")
# Also show per-modality descriptives for reference (not used in main ANOVA)
cat("\n--- Risset Blocks: descriptives by Modality (reference only, not in ANOVA) ---\n")
print(risset_blocks %>% group_by(Modality) %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\n--- Shepard Blocks: descriptives by Modality (reference only, not in ANOVA) ---\n")
print(shepard_blocks %>% group_by(Modality) %>% get_summary_stats(Score_N, type="mean_sd"))
# --- Ranking summaries (full two-way) ---
summarise_ranking <- function(df, label) {
cat(sprintf("\n=== SUMMARY STATISTICS: %s ===\n", label))
cat("\nOverall:\n")
print(df %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Modality:\n")
print(df %>% group_by(Modality) %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Stimulus:\n")
print(df %>% group_by(Filename) %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Modality x Stimulus:\n")
print(df %>% group_by(Modality, Filename) %>% get_summary_stats(Score_N, type="mean_sd"))
cat("\nBy Participant:\n")
print(df %>% group_by(ParticipantID) %>% get_summary_stats(Score_N, type="mean_sd"))
}
summarise_ranking(risset_ranking,  "Risset Ranking Summary")
summarise_ranking(shepard_ranking, "Shepard Ranking Summary")
# ========================================
# 5. ASSUMPTION CHECKS
# ========================================
# --- Blocks (collapsed) ---
check_assumptions_oneway <- function(df, label) {
cat(sprintf("\n=== ASSUMPTION CHECKS: %s (collapsed across modality) ===\n", label))
cat("\nOutlier Detection (by Filename):\n")
outliers <- df %>% group_by(Filename) %>% identify_outliers(Score_N)
if (nrow(outliers) > 0) {
print(outliers)
cat(sprintf("  -> %d outlier(s) detected\n", nrow(outliers)))
} else {
cat("  -> No outliers detected\n")
}
cat("\nNormality Test (Shapiro-Wilk by Filename):\n")
identical_groups <- df %>%
group_by(Filename) %>%
filter(n_distinct(Score_N) == 1) %>%
summarise(Score_N_value = unique(Score_N), .groups="drop")
if (nrow(identical_groups) > 0) {
cat("  WARNING: Groups with identical values (Shapiro-Wilk skipped):\n")
print(identical_groups)
}
normality <- df %>%
group_by(Filename) %>%
filter(n_distinct(Score_N) > 1) %>%
shapiro_test(Score_N)
print(normality)
violations <- normality %>% filter(p < 0.05)
if (nrow(violations) > 0) {
cat(sprintf("  WARNING: Normality violated in %d group(s):\n", nrow(violations)))
print(violations)
} else {
cat("  -> All tested groups meet normality assumption\n")
}
cat("  NOTE: With small samples, normality tests have low power.\n")
cat("        Visual inspection is recommended alongside these results.\n")
}
check_assumptions_oneway(risset_blocks_collapsed,  "Risset Blocks")
check_assumptions_oneway(shepard_blocks_collapsed, "Shepard Blocks")
# --- Ranking summaries ---
check_assumptions_twoway <- function(df, label) {
cat(sprintf("\n=== ASSUMPTION CHECKS: %s ===\n", label))
cat("\nOutlier Detection (by Modality x Filename):\n")
outliers <- df %>% group_by(Modality, Filename) %>% identify_outliers(Score_N)
if (nrow(outliers) > 0) {
print(outliers)
cat(sprintf("  -> %d outlier(s) detected\n", nrow(outliers)))
} else {
cat("  -> No outliers detected\n")
}
cat("\nNormality Test (Shapiro-Wilk by Modality x Filename):\n")
identical_groups <- df %>%
group_by(Modality, Filename) %>%
filter(n_distinct(Score_N) == 1) %>%
summarise(Score_N_value = unique(Score_N), .groups="drop")
if (nrow(identical_groups) > 0) {
cat("  WARNING: Groups with identical values (Shapiro-Wilk skipped):\n")
print(identical_groups)
}
normality <- df %>%
group_by(Modality, Filename) %>%
filter(n_distinct(Score_N) > 1) %>%
shapiro_test(Score_N)
print(normality)
violations <- normality %>% filter(p < 0.05)
if (nrow(violations) > 0) {
cat(sprintf("  WARNING: Normality violated in %d group(s):\n", nrow(violations)))
print(violations)
} else {
cat("  -> All tested groups meet normality assumption\n")
}
cat("  NOTE: With small samples, normality tests have low power.\n")
cat("        Visual inspection is recommended alongside these results.\n")
}
check_assumptions_twoway(risset_ranking,  "Risset Ranking Summary")
check_assumptions_twoway(shepard_ranking, "Shepard Ranking Summary")
# ========================================
# 6. ANOVA
# ========================================
# --- Blocks: one-way RM-ANOVA on Stimulus (collapsed across modality) ---
run_anova_oneway <- function(df, label) {
cat(sprintf("\n\n=== ONE-WAY REPEATED MEASURES ANOVA: %s ===\n", label))
cat("(Score averaged across modalities — modality excluded as a factor\n")
cat(" because block order was fixed, not randomised)\n\n")
result <- anova_test(
data        = df,
dv          = Score_N,
wid         = ParticipantID,
within      = Filename,
effect.size = "pes"
)
tbl <- data.frame(get_anova_table(result))
cat("ANOVA Table:\n")
print(tbl)
cat("\nInterpretation:\n")
cat(rep("-", 60), "\n", sep="")
filename_p <- tbl %>% filter(Effect == "Filename") %>% pull(p)
if (length(filename_p) > 0) {
if (filename_p < 0.05) {
cat(sprintf("  STIMULUS: Significant (p = %.4f)\n", filename_p))
cat("    -> Scores differ across stimuli (averaged across modalities)\n")
} else {
cat(sprintf("  STIMULUS: Not significant (p = %.4f)\n", filename_p))
cat("    -> No reliable difference between stimuli\n")
}
}
cat(rep("-", 60), "\n", sep="")
list(table = tbl, filename_p = filename_p)
}
# --- Blocks: exploratory one-way RM-ANOVA per modality ---
run_anova_per_modality <- function(df, label) {
cat(sprintf("\n\n=== EXPLORATORY ONE-WAY ANOVA PER MODALITY: %s ===\n", label))
cat("(Descriptive only — modality order was fixed so results are not inferential\n")
cat(" for modality differences, but useful for understanding stimulus effects\n")
cat(" within each condition)\n\n")
for (mod in levels(df$Modality)) {
cat(sprintf("\n  -- Modality: %s --\n", mod))
df_mod <- df %>% filter(Modality == mod)
result <- anova_test(
data        = df_mod,
dv          = Score_N,
wid         = ParticipantID,
within      = Filename,
effect.size = "pes"
)
print(data.frame(get_anova_table(result)))
}
}
anova_risset_blocks  <- run_anova_oneway(risset_blocks_collapsed,  "Risset Blocks")
anova_shepard_blocks <- run_anova_oneway(shepard_blocks_collapsed, "Shepard Blocks")
run_anova_per_modality(risset_blocks,  "Risset Blocks")
run_anova_per_modality(shepard_blocks, "Shepard Blocks")
# --- Ranking summaries: two-way RM-ANOVA (Modality x Stimulus) ---
run_anova_twoway <- function(df, label) {
cat(sprintf("\n\n=== TWO-WAY REPEATED MEASURES ANOVA: %s ===\n", label))
cat("(Both Modality and Stimulus were randomised — two-way design is appropriate)\n\n")
result <- anova_test(
data        = df,
dv          = Score_N,
wid         = ParticipantID,
within      = c(Modality, Filename),
effect.size = "pes"
)
tbl <- data.frame(get_anova_table(result))
cat("ANOVA Table:\n")
print(tbl)
cat("\nInterpretation:\n")
cat(rep("-", 60), "\n", sep="")
modality_p    <- tbl %>% filter(Effect == "Modality")         %>% pull(p)
filename_p    <- tbl %>% filter(Effect == "Filename")         %>% pull(p)
interaction_p <- tbl %>% filter(Effect == "Modality:Filename") %>% pull(p)
if (length(modality_p) > 0) {
if (modality_p < 0.05) {
cat(sprintf("  MODALITY:    Significant (p = %.4f)\n", modality_p))
cat("    -> Scores differ across both/haptic/audio conditions\n")
} else {
cat(sprintf("  MODALITY:    Not significant (p = %.4f)\n", modality_p))
cat("    -> No reliable difference across modality conditions\n")
}
}
if (length(filename_p) > 0) {
if (filename_p < 0.05) {
cat(sprintf("  STIMULUS:    Significant (p = %.4f)\n", filename_p))
cat("    -> Different stimuli receive different scores\n")
} else {
cat(sprintf("  STIMULUS:    Not significant (p = %.4f)\n", filename_p))
cat("    -> All stimuli rated similarly\n")
}
}
if (length(interaction_p) > 0) {
if (interaction_p < 0.05) {
cat(sprintf("  INTERACTION: Significant (p = %.4f)\n", interaction_p))
cat("    -> Effect of modality depends on the specific stimulus\n")
} else {
cat(sprintf("  INTERACTION: Not significant (p = %.4f)\n", interaction_p))
cat("    -> Effect of modality is consistent across stimuli\n")
}
}
cat(rep("-", 60), "\n", sep="")
list(table = tbl, interaction_p = interaction_p)
}
anova_risset_ranking  <- run_anova_twoway(risset_ranking,  "Risset Ranking Summary")
anova_shepard_ranking <- run_anova_twoway(shepard_ranking, "Shepard Ranking Summary")
# ========================================
# 7. POST-HOC TESTS
# ========================================
# --- Blocks: post-hoc on Stimulus only ---
run_posthoc_oneway <- function(df, label) {
cat(sprintf("\n\n=== POST-HOC COMPARISONS: %s (Stimulus only) ===\n", label))
ph_stimulus <- df %>%
pairwise_t_test(Score_N ~ Filename, paired=TRUE, p.adjust.method="bonferroni")
print(ph_stimulus)
list(stimulus = ph_stimulus)
}
ph_risset_blocks  <- run_posthoc_oneway(risset_blocks_collapsed,  "Risset Blocks")
ph_shepard_blocks <- run_posthoc_oneway(shepard_blocks_collapsed, "Shepard Blocks")
# --- Ranking summaries: post-hoc on both factors ---
run_posthoc_twoway <- function(df, label) {
cat(sprintf("\n\n=== POST-HOC COMPARISONS: %s ===\n", label))
cat("\nPairwise comparisons for MODALITY (Bonferroni):\n")
ph_modality <- df %>%
pairwise_t_test(Score_N ~ Modality, paired=TRUE, p.adjust.method="bonferroni")
print(ph_modality)
cat("\nPairwise comparisons for STIMULUS (Bonferroni):\n")
ph_stimulus <- df %>%
pairwise_t_test(Score_N ~ Filename, paired=TRUE, p.adjust.method="bonferroni")
print(ph_stimulus)
list(modality = ph_modality, stimulus = ph_stimulus)
}
ph_risset_ranking  <- run_posthoc_twoway(risset_ranking,  "Risset Ranking Summary")
ph_shepard_ranking <- run_posthoc_twoway(shepard_ranking, "Shepard Ranking Summary")
# ========================================
# 8. SIMPLE MAIN EFFECTS (ranking only, if interaction significant)
# ========================================
run_simple_effects <- function(df, anova_result, label) {
if (anova_result$interaction_p < 0.05) {
cat(sprintf("\n\n=== SIMPLE MAIN EFFECTS: %s ===\n", label))
cat("\nEffect of MODALITY at each STIMULUS:\n")
simple_modality <- df %>%
group_by(Filename) %>%
anova_test(dv=Score_N, wid=ParticipantID, within=Modality) %>%
get_anova_table() %>%
adjust_pvalue(method="bonferroni")
print(simple_modality)
cat("\nEffect of STIMULUS at each MODALITY:\n")
simple_stimulus <- df %>%
group_by(Modality) %>%
anova_test(dv=Score_N, wid=ParticipantID, within=Filename) %>%
get_anova_table() %>%
adjust_pvalue(method="bonferroni")
print(simple_stimulus)
}
}
run_simple_effects(risset_ranking,  anova_risset_ranking,  "Risset Ranking Summary")
run_simple_effects(shepard_ranking, anova_shepard_ranking, "Shepard Ranking Summary")
